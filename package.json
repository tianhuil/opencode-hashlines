{
  "name": "@tianhuil/opencode-hashlines",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tianhuil/opencode-hashlines"
  },
  "keywords": [
    "opencode",
    "plugin",
    "hashlines",
    "file-editing",
    "hash-anchored"
  ],
  "description": "A plugin for OpenCode that provides hash-anchored file reading and editing to prevent corruption from stale line references",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/hashline-plugin.ts ./src/lib/hashline.ts ./src/lib/types.ts --outdir dist/src --target node --splitting && tsc",
    "dev": "bun run build --watch",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.2.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5"
  }
}
